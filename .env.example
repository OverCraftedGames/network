# Copy this file to .env (same folder) and fill both values in.
# .env is ignored by git, so the token never leaves this PC.
# Run a sync with:  node --env-file=.env scripts/sync-news.mjs

# Discord Developer Portal > your application > Bot > Reset Token
DISCORD_BOT_TOKEN=

# Right-click the announcements channel in Discord > Copy Channel ID (needs Developer Mode on)
DISCORD_NEWS_CHANNEL_ID=
